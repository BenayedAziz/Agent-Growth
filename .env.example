# ---------------------------------------------------------------------------
# À recopier dans Railway → ton service → Variables. Jamais dans Git.
# ---------------------------------------------------------------------------

# Obligatoires ---------------------------------------------------------------
# Mot de passe de la console. Sans lui, elle refuse de démarrer en ligne.
AG_CONSOLE_PASSWORD=
# Identifiant de connexion (défaut : admin)
# AG_CONSOLE_USER=admin

# Clé API Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Telegram (validation en un geste) ------------------------------------------
# Jeton donné par @BotFather
TELEGRAM_BOT_TOKEN=
# Ton identifiant : envoie /start à ton bot, il te le donne.
TELEGRAM_OWNER_ID=

# Base -----------------------------------------------------------------------
# Fixé par le Dockerfile sur le volume persistant. Ne pas changer.
# AG_DB=/data/console.db

# Optionnel : modèle principal (défaut : claude-opus-5-5)
# AG_MODEL=claude-opus-5-5

# Accès aux sites — un NOM par site, déclaré avec « ag site add --secret-ref » -
# WordPress : mot de passe d'application (Utilisateurs → Profil)
# WP_EGYPTOURS=
# Shopify : jeton Admin API (droits read_content, write_content)
# SHOPIFY_ORIA=
# Site sur mesure : jeton GitHub à droits limités au dépôt (contents + pull requests)
# GITHUB_ORIA=
